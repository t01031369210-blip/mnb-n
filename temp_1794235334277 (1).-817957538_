```html
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>성경통독 기록</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'app-bg': '#1a1a1a',
                        'app-card': '#2a2a2a',
                        'app-gold': '#c99c5f',
                        'app-gold-dark': '#b0864e',
                        'app-text-main': '#ffffff',
                        'app-text-muted': '#9ca3af',
                        'app-border': '#3f3f46'
                    }
                }
            }
        }
    </script>
    <style>
        /* Hide scrollbar for a cleaner app look */
        ::-webkit-scrollbar {
            display: none;
        }
        body {
            -ms-overflow-style: none;
            scrollbar-width: none;
            background-color: #1a1a1a;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .date-cell.selected {
            border: 1px solid #c99c5f;
            background-color: rgba(201, 156, 95, 0.1);
        }
        .badge {
            background-color: #c99c5f;
            color: #1a1a1a;
            font-size: 0.6rem;
            padding: 1px 5px;
            border-radius: 8px;
            font-weight: 700;
            line-height: 1.2;
        }
    </style>
</head>
<body class="text-app-text-main">

    <!-- Main App Container -->
    <div id="app" class="max-w-md mx-auto min-h-screen flex flex-col relative pb-10">
        
        <!-- Header -->
        <header class="pt-8 pb-4 px-4 text-center">
            <h1 class="text-xl font-bold">📖 성경통독 기록</h1>
        </header>

        <!-- Tabs -->
        <div class="flex px-4 mb-4 space-x-2">
            <button id="tab-calendar" class="flex-1 py-3 rounded-xl font-medium text-sm transition-colors bg-app-gold text-app-bg" onclick="switchTab('calendar')">
                달력
            </button>
            <button id="tab-all" class="flex-1 py-3 rounded-xl font-medium text-sm transition-colors bg-app-card text-app-text-muted" onclick="switchTab('all')">
                전체 기록
            </button>
        </div>

        <!-- Tab Content: Calendar -->
        <div id="view-calendar" class="flex-1 flex flex-col px-4 gap-4">
            
            <!-- Calendar Card -->
            <div class="bg-app-card rounded-2xl p-4 shadow-lg">
                <!-- Month Navigation -->
                <div class="flex justify-between items-center mb-4 px-2">
                    <button onclick="changeMonth(-1)" class="p-2 hover:bg-white/10 rounded-full transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <h2 id="calendar-title" class="text-lg font-bold">2026년 11월</h2>
                    <button onclick="changeMonth(1)" class="p-2 hover:bg-white/10 rounded-full transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>

                <!-- Days of Week -->
                <div class="grid grid-cols-7 text-center text-xs text-app-text-muted mb-2">
                    <div>일</div><div>월</div><div>화</div><div>수</div><div>목</div><div>금</div><div>토</div>
                </div>

                <!-- Calendar Grid -->
                <div id="calendar-grid" class="grid grid-cols-7 gap-1 text-sm">
                    <!-- JS will populate dates here -->
                </div>
            </div>
            
            <!-- Daily Records (Below Calendar) -->
            <div class="mt-4 mb-4">
                <div class="flex justify-between items-center mb-3">
                    <h3 id="daily-records-title" class="text-sm font-bold text-app-gold">오늘의 기록</h3>
                    <button onclick="openDateModal()" class="bg-app-gold/10 text-app-gold border border-app-gold/30 text-xs px-3 py-1.5 rounded-lg font-bold hover:bg-app-gold hover:text-app-bg transition">새 기록</button>
                </div>
                <div id="daily-records-list" class="space-y-3">
                    <!-- JS will populate daily records here -->
                </div>
            </div>
        </div>

        <!-- Tab Content: All Records -->
        <div id="view-all" class="hidden flex-1 px-4 pb-4">
            <div class="bg-app-card rounded-2xl p-4 shadow-lg min-h-full">
                <!-- Header & Filters -->
                <div class="flex flex-col gap-3 mb-4 border-b border-app-border pb-3">
                    <h2 class="text-lg font-bold">전체 기록</h2>
                    
                    <!-- Filter Controls Grid -->
                    <div class="flex flex-col gap-3">
                        <!-- Group Member Filter Dropdown -->
                        <div>
                            <label class="block text-[11px] text-app-text-muted mb-1 font-medium">그룹원 선택</label>
                            <select id="filter-member" onchange="onFilterChange()" class="w-full bg-app-bg text-white text-xs border border-app-border rounded-lg p-2 focus:outline-none focus:border-app-gold font-medium">
                                <option value="ALL">👤 모든 그룹원</option>
                            </select>
                        </div>
                        
                        <!-- Date Filter Input -->
                        <div>
                            <label class="block text-[11px] text-app-text-muted mb-1 font-medium">날짜 선택</label>
                            <div class="flex items-center gap-1.5 w-full">
                                <button onclick="changeFilterDate(-1)" class="bg-app-bg text-app-text-muted hover:text-white border border-app-border px-2 py-2 rounded-lg text-xs shrink-0 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                                </button>
                                <input type="date" id="filter-date" onchange="onFilterChange()" class="flex-1 bg-app-bg text-white text-xs border border-app-border rounded-lg p-2 focus:outline-none focus:border-app-gold text-center min-w-0">
                                <button onclick="changeFilterDate(1)" class="bg-app-bg text-app-text-muted hover:text-white border border-app-border px-2 py-2 rounded-lg text-xs shrink-0 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                </button>
                                <button onclick="clearDateFilter()" title="전체 날짜 보기" class="bg-app-bg text-app-text-muted hover:text-white border border-app-border px-3 py-2 rounded-lg text-xs shrink-0 whitespace-nowrap">
                                    전체
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="all-records-list" class="space-y-4">
                    <!-- JS will populate all records here -->
                </div>
            </div>
        </div>

    </div>

    <!-- Date Detail & Record Modal -->
    <div id="date-detail-modal" class="fixed inset-0 bg-black/80 flex items-end sm:items-center justify-center z-50 hidden">
        <div class="bg-app-card w-full max-w-md rounded-t-3xl sm:rounded-2xl p-5 sm:p-6 shadow-2xl border-t sm:border border-app-border max-h-[90vh] flex flex-col transition-transform transform translate-y-full duration-300" id="date-detail-content">
            
            <!-- Modal Header -->
            <div class="flex justify-between items-center border-b border-app-border pb-3 mb-4 shrink-0">
                <h3 id="modal-date-title" class="text-lg font-bold text-white">2026년 11월 10일 기록하기</h3>
                <button onclick="closeDateModal()" class="text-app-text-muted hover:text-white p-2 -mr-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- New Record Form -->
            <div class="overflow-y-auto">
                
                <div class="mb-3">
                    <label class="block text-xs text-app-text-muted mb-1">이름 (닉네임)</label>
                    <input type="text" id="input-name" placeholder="이름을 입력하세요" 
                        class="w-full bg-app-bg text-white border border-app-border rounded-lg p-2.5 text-sm focus:outline-none focus:border-app-gold transition">
                </div>

                <div class="mb-3">
                    <label class="block text-xs text-app-text-muted mb-1">읽은 범위</label>
                    <div class="flex items-center space-x-2 mb-2">
                        <span class="text-xs text-app-text-muted w-6 text-center">시작</span>
                        <select id="start-book" onchange="updateChapterDropdown('start')" class="flex-1 bg-app-bg text-white border border-app-border rounded-lg p-2 text-sm focus:outline-none focus:border-app-gold"></select>
                        <select id="start-chapter" class="w-20 bg-app-bg text-white border border-app-border rounded-lg p-2 text-sm focus:outline-none focus:border-app-gold text-center"></select>
                        <span class="text-xs text-app-text-muted">장</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="text-xs text-app-text-muted w-6 text-center">끝</span>
                        <select id="end-book" onchange="updateChapterDropdown('end')" class="flex-1 bg-app-bg text-white border border-app-border rounded-lg p-2 text-sm focus:outline-none focus:border-app-gold"></select>
                        <select id="end-chapter" class="w-20 bg-app-bg text-white border border-app-border rounded-lg p-2 text-sm focus:outline-none focus:border-app-gold text-center"></select>
                        <span class="text-xs text-app-text-muted">장</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-xs text-app-text-muted mb-1">묵상 (선택)</label>
                    <textarea id="input-meditation" rows="2" placeholder="말씀을 통해 느낀 점" 
                        class="w-full bg-app-bg text-white border border-app-border rounded-lg p-2.5 text-sm focus:outline-none focus:border-app-gold transition resize-none"></textarea>
                </div>

                <button id="btn-submit" onclick="submitRecord()" class="w-full bg-app-gold text-app-bg hover:bg-app-gold-dark font-bold py-3 px-4 rounded-lg transition-colors flex items-center justify-center shadow">
                    기록 저장하기
                </button>
            </div>
        </div>
    </div>

    <!-- Delete Confirm Modal -->
    <div id="delete-confirm-modal" class="fixed inset-0 bg-black/80 flex items-center justify-center z-50 hidden">
        <div class="bg-app-card w-[90%] max-w-sm rounded-2xl p-6 shadow-2xl border border-app-border flex flex-col transition-transform transform scale-95 opacity-0" id="delete-confirm-content">
            <h3 class="text-lg font-bold text-white mb-2">기록 삭제</h3>
            <p class="text-sm text-app-text-muted mb-6">정말 이 기록을 삭제하시겠습니까?<br>삭제된 기록은 복구할 수 없습니다.</p>
            <div class="flex space-x-3">
                <button onclick="closeDeleteModal()" class="flex-1 py-3 rounded-lg font-bold text-sm bg-app-bg border border-app-border text-white hover:bg-white/5 transition">취소</button>
                <button onclick="executeDelete()" class="flex-1 py-3 rounded-lg font-bold text-sm bg-red-500/10 text-red-500 border border-red-500/30 hover:bg-red-500 hover:text-white transition">삭제</button>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="fixed inset-0 bg-black/60 flex items-center justify-center z-40">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-app-gold"></div>
    </div>

    <!-- Firebase Logic -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, onSnapshot, addDoc, serverTimestamp, doc, updateDoc, deleteDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Environment Variables
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'bible-tracker-default';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            projectId: "mock-project"
        };
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        // State
        let app, db, auth;
        let currentUser = null;
        let allRecords = [];
        let editingRecordId = null;
        let deletingRecordId = null;
        
        // 날짜 관련 유틸 함수 (미리 선언)
        function formatDate(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }
        
        let filterMember = 'ALL';
        let filterDate = formatDate(new Date()); // 기본값을 오늘 날짜로 설정
        
        let currentYear = new Date().getFullYear();
        let currentMonth = new Date().getMonth(); // 0-11
        let selectedDateStr = formatDate(new Date()); // YYYY-MM-DD
        let userNickname = localStorage.getItem('bibleTrackerNickname') || '';
        let currentTab = 'calendar';

        const bibleData = [
            { name: "창세기", chapters: 50 }, { name: "출애굽기", chapters: 40 }, { name: "레위기", chapters: 27 }, { name: "민수기", chapters: 36 }, { name: "신명기", chapters: 34 },
            { name: "여호수아", chapters: 24 }, { name: "사사기", chapters: 21 }, { name: "룻기", chapters: 4 }, { name: "사무엘상", chapters: 31 }, { name: "사무엘하", chapters: 24 },
            { name: "열왕기상", chapters: 22 }, { name: "열왕기하", chapters: 25 }, { name: "역대상", chapters: 29 }, { name: "역대하", chapters: 36 }, { name: "에스라", chapters: 10 },
            { name: "느헤미야", chapters: 13 }, { name: "에스더", chapters: 10 }, { name: "욥기", chapters: 42 }, { name: "시편", chapters: 150 }, { name: "잠언", chapters: 31 },
            { name: "전도서", chapters: 12 }, { name: "아가", chapters: 8 }, { name: "이사야", chapters: 66 }, { name: "예레미야", chapters: 52 }, { name: "예레미야애가", chapters: 5 },
            { name: "에스겔", chapters: 48 }, { name: "다니엘", chapters: 12 }, { name: "호세아", chapters: 14 }, { name: "요엘", chapters: 3 }, { name: "아모스", chapters: 9 },
            { name: "오바댜", chapters: 1 }, { name: "요나", chapters: 4 }, { name: "미가", chapters: 7 }, { name: "나훔", chapters: 3 }, { name: "하박국", chapters: 3 },
            { name: "스바냐", chapters: 3 }, { name: "학개", chapters: 2 }, { name: "스가랴", chapters: 14 }, { name: "말라기", chapters: 4 },
            { name: "마태복음", chapters: 28 }, { name: "마가복음", chapters: 16 }, { name: "누가복음", chapters: 24 }, { name: "요한복음", chapters: 21 }, { name: "사도행전", chapters: 28 },
            { name: "로마서", chapters: 16 }, { name: "고린도전서", chapters: 16 }, { name: "고린도후서", chapters: 13 }, { name: "갈라디아서", chapters: 6 }, { name: "에베소서", chapters: 6 },
            { name: "빌립보서", chapters: 4 }, { name: "골로새서", chapters: 4 }, { name: "데살로니가전서", chapters: 5 }, { name: "데살로니가후서", chapters: 3 }, { name: "디모데전서", chapters: 6 },
            { name: "디모데후서", chapters: 4 }, { name: "디도서", chapters: 3 }, { name: "빌레몬서", chapters: 1 }, { name: "히브리서", chapters: 13 }, { name: "야고보서", chapters: 5 },
            { name: "베드로전서", chapters: 5 }, { name: "베드로후서", chapters: 3 }, { name: "요한1서", chapters: 5 }, { name: "요한2서", chapters: 1 }, { name: "요한3서", chapters: 1 },
            { name: "유다서", chapters: 1 }, { name: "요한계시록", chapters: 22 }
        ];

        // DOM Elements
        const elGrid = document.getElementById('calendar-grid');
        const elCalendarTitle = document.getElementById('calendar-title');
        const elAllRecordsList = document.getElementById('all-records-list');
        const elLoading = document.getElementById('loading-overlay');

        // Initialization
        async function init() {
            try {
                // Initialize Firebase
                app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                // Authentication (Rule 3: Auth Before Queries)
                if (initialAuthToken) {
                    await signInWithCustomToken(auth, initialAuthToken);
                } else {
                    await signInAnonymously(auth);
                }
                currentUser = auth.currentUser;

                // Setup Listeners
                setupRealtimeListener();
                
                // Init Bible dropdowns
                initBibleDropdowns();

                // Set initial date filter UI
                const dateEl = document.getElementById('filter-date');
                if (dateEl) dateEl.value = filterDate;

                // Initial Render
                updateUI();
                
            } catch (error) {
                console.error("Initialization error:", error);
                alertCustom("초기화 중 오류가 발생했습니다. 페이지를 새로고침 해주세요.");
            }
        }

        // Real-time Data Sync (Rule 1 & 2: Public data path, no complex queries)
        function setupRealtimeListener() {
            if (!currentUser) return;

            const recordsRef = collection(db, 'artifacts', appId, 'public', 'data', 'reading_records');
            
            // Note: Mandatory rule dictates no orderBy or where clauses here if complex.
            // We fetch all records in this collection and sort/filter in memory.
            onSnapshot(recordsRef, (snapshot) => {
                const records = [];
                snapshot.forEach((doc) => {
                    const data = doc.data();
                    records.push({
                        id: doc.id,
                        ...data,
                        // handle serverTimestamp being null during optimistic local write
                        timestamp: data.timestamp ? data.timestamp.toMillis() : Date.now() 
                    });
                });

                // Sort descending by timestamp in memory
                allRecords = records.sort((a, b) => b.timestamp - a.timestamp);
                
                elLoading.style.display = 'none';
                updateUI();
            }, (error) => {
                console.error("Firestore sync error:", error);
                elLoading.style.display = 'none';
                alertCustom("데이터를 불러오는데 실패했습니다.");
            });
        }

        // Data Writing
        window.submitRecord = async function() {
            if (!currentUser) return;
            if (!userNickname) {
                window.openNicknameModal();
                return;
            }

            const rangeVal = document.getElementById('input-range').value.trim();
            const medVal = document.getElementById('input-meditation').value.trim();

            if (!rangeVal) {
                alertCustom("읽은 범위를 입력해주세요.");
                return;
            }

            // UI Feedback
            const originalText = elBtnSubmit.innerText;
            elBtnSubmit.innerText = "저장 중...";
            elBtnSubmit.disabled = true;
            elBtnSubmit.classList.add('opacity-50', 'cursor-not-allowed');

            try {
                const recordsRef = collection(db, 'artifacts', appId, 'public', 'data', 'reading_records');
                await addDoc(recordsRef, {
                    userId: currentUser.uid,
                    nickname: userNickname,
                    date: selectedDateStr,
                    range: rangeVal,
                    meditation: medVal,
                    timestamp: serverTimestamp()
                });

                // Clear inputs
                document.getElementById('input-range').value = '';
                document.getElementById('input-meditation').value = '';
                
            } catch (error) {
                console.error("Error adding document: ", error);
                alertCustom("저장에 실패했습니다. 다시 시도해주세요.");
            } finally {
                // Restore button
                elBtnSubmit.innerText = originalText;
                elBtnSubmit.disabled = false;
                elBtnSubmit.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        };

        // --- UI Rendering & Logic ---

        function updateUI() {
            if (currentTab === 'calendar') {
                renderCalendar();
                if (window.renderDailyRecords) renderDailyRecords();
            } else {
                renderAllRecordsView();
            }
        }

        function renderCalendar() {
            elGrid.innerHTML = '';
            elCalendarTitle.innerText = `${currentYear}년 ${currentMonth + 1}월`;

            const firstDay = new Date(currentYear, currentMonth, 1).getDay(); // 0(Sun) - 6(Sat)
            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

            // Calculate record counts per day for the current view
            const countsPerDay = {};
            const prefix = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}`;
            allRecords.forEach(rec => {
                if (rec.date.startsWith(prefix)) {
                    countsPerDay[rec.date] = (countsPerDay[rec.date] || 0) + 1;
                }
            });

            // Empty cells before 1st day
            for (let i = 0; i < firstDay; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'aspect-square flex items-center justify-center text-app-text-muted opacity-20';
                elGrid.appendChild(emptyCell);
            }

            // Days
            const todayStr = formatDate(new Date());

            for (let i = 1; i <= daysInMonth; i++) {
                const dayDateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
                
                const cell = document.createElement('div');
                cell.className = 'relative aspect-square flex flex-col items-center justify-between py-1.5 px-0.5 rounded-lg cursor-pointer transition-colors hover:bg-white/5 date-cell border border-transparent bg-app-bg';
                
                if (dayDateStr === selectedDateStr) {
                    cell.classList.add('selected');
                } else if (dayDateStr === todayStr) {
                     cell.classList.add('border-app-border');
                }

                cell.innerHTML = `<span class="text-sm font-bold leading-none mt-0.5">${i}</span>`;
                
                // Add Badge if records exist
                if (countsPerDay[dayDateStr]) {
                    const badge = document.createElement('div');
                    badge.className = 'badge shadow-sm mb-0.5';
                    badge.innerText = `${countsPerDay[dayDateStr]}건`;
                    cell.appendChild(badge);
                } else {
                    const spacer = document.createElement('div');
                    spacer.className = 'h-3';
                    cell.appendChild(spacer);
                }

                cell.onclick = () => {
                    selectedDateStr = dayDateStr;
                    renderCalendar(); // re-render to update selection highlight
                    renderDailyRecords(); // 달력 하단 기록 업데이트
                    openDateModal(); // 모달 띄우기
                };

                elGrid.appendChild(cell);
            }
        }

        // --- Date Modal & Form Logic ---
        
        window.openDateModal = function() {
            editingRecordId = null; // 새 기록 작성 모드로 초기화
            document.getElementById('btn-submit').innerText = "기록 저장하기";
            document.getElementById('input-meditation').value = '';
            
            const [y, m, d] = selectedDateStr.split('-');
            document.getElementById('modal-date-title').innerText = `${y}년 ${m}월 ${d}일 기록하기`;
            
            const savedName = localStorage.getItem('bibleTrackerNickname') || '';
            document.getElementById('input-name').value = savedName;

            const modal = document.getElementById('date-detail-modal');
            const content = document.getElementById('date-detail-content');
            modal.classList.remove('hidden');
            
            requestAnimationFrame(() => {
                content.classList.remove('translate-y-full');
            });
        };

        window.closeDateModal = function() {
            const modal = document.getElementById('date-detail-modal');
            const content = document.getElementById('date-detail-content');
            content.classList.add('translate-y-full');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        };

        window.renderDailyRecords = function() {
            const listEl = document.getElementById('daily-records-list');
            const titleEl = document.getElementById('daily-records-title');
            if (!listEl) return;
            
            const [y, m, d] = selectedDateStr.split('-');
            if (titleEl) titleEl.innerText = `${y}년 ${parseInt(m)}월 ${parseInt(d)}일 기록`;

            // 본인(현재 기기)의 기록만 보이도록 필터링 조건 추가
            const dailyRecords = allRecords.filter(r => r.date === selectedDateStr && currentUser && r.userId === currentUser.uid);
            listEl.innerHTML = '';

            if (dailyRecords.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-6 text-app-text-muted text-sm border border-dashed border-app-border rounded-xl bg-app-bg/30">
                        이 날짜에 남긴 기록이 없습니다.
                    </div>
                `;
            } else {
                dailyRecords.forEach(rec => {
                    const isMe = currentUser && rec.userId === currentUser.uid;
                    let actionsHtml = '';
                    if (isMe) {
                        actionsHtml = `
                            <div class="flex items-center gap-2 ml-2 border-l border-app-border/50 pl-2">
                                <button onclick="openEditModal('${rec.id}')" class="text-[11px] text-app-text-muted hover:text-white transition">수정</button>
                                <button onclick="confirmDelete('${rec.id}')" class="text-[11px] text-app-text-muted hover:text-red-400 transition">삭제</button>
                            </div>
                        `;
                    }
                    
                    const el = document.createElement('div');
                    el.className = `p-3.5 rounded-xl border ${isMe ? 'border-app-gold/30 bg-app-gold/5' : 'border-app-border bg-app-bg'} shadow-sm`;
                    el.innerHTML = `
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="font-bold text-sm text-app-gold">${escapeHtml(rec.nickname)}</span>
                            <div class="flex items-center">
                                <span class="text-xs text-app-text-muted">${formatTime(rec.timestamp)}</span>
                                ${actionsHtml}
                            </div>
                        </div>
                        <div class="text-sm text-white break-words font-medium mb-1">
                            📖 ${escapeHtml(rec.range)}
                        </div>
                        ${rec.meditation ? `<div class="text-xs text-gray-300 break-words whitespace-pre-wrap mt-2 pt-2 border-t border-app-border/30">${escapeHtml(rec.meditation)}</div>` : ''}
                    `;
                    listEl.appendChild(el);
                });
            }
        };

        // --- Dropdown Logic ---
        
        function initBibleDropdowns() {
            const startBookSelect = document.getElementById('start-book');
            const endBookSelect = document.getElementById('end-book');
            
            let optionsHtml = '';
            bibleData.forEach((book, index) => {
                optionsHtml += `<option value="${index}">${book.name}</option>`;
            });

            startBookSelect.innerHTML = optionsHtml;
            endBookSelect.innerHTML = optionsHtml;

            updateChapterDropdown('start');
            updateChapterDropdown('end');
        }

        window.updateChapterDropdown = function(type) {
            const bookIndex = document.getElementById(`${type}-book`).value;
            const chapterSelect = document.getElementById(`${type}-chapter`);
            const maxChapters = bibleData[bookIndex].chapters;
            
            const currentVal = chapterSelect.value;
            
            let optionsHtml = '';
            for (let i = 1; i <= maxChapters; i++) {
                optionsHtml += `<option value="${i}">${i}</option>`;
            }
            chapterSelect.innerHTML = optionsHtml;
            
            if (currentVal && parseInt(currentVal) <= maxChapters) {
                chapterSelect.value = currentVal;
            } else {
                chapterSelect.value = 1;
            }
        };

        // Parse existing range string into dropdown values
        function parseRangeStr(rangeStr) {
            const parts = rangeStr.split('~').map(s => s.trim());
            const parsePart = (str) => {
                const match = str.match(/([가-힣0-9]+)\s+(\d+)장/);
                return match ? { book: match[1], chapter: match[2] } : null;
            };
            const start = parsePart(parts[0]);
            const end = parts.length > 1 ? parsePart(parts[1]) : start;
            return { start, end };
        }

        // Open edit modal and populate data
        window.openEditModal = function(id) {
            const rec = allRecords.find(r => r.id === id);
            if (!rec) return;
            
            editingRecordId = id;
            selectedDateStr = rec.date; // 수정하는 기록의 날짜로 맞춤
            
            const [y, m, d] = rec.date.split('-');
            document.getElementById('modal-date-title').innerText = `${y}년 ${m}월 ${d}일 기록 수정`;
            
            document.getElementById('input-name').value = rec.nickname;
            document.getElementById('input-meditation').value = rec.meditation || '';
            
            const parsed = parseRangeStr(rec.range);
            if (parsed.start && parsed.end) {
                const sIdx = bibleData.findIndex(b => b.name === parsed.start.book);
                if (sIdx !== -1) {
                    document.getElementById('start-book').value = sIdx;
                    updateChapterDropdown('start');
                    document.getElementById('start-chapter').value = parsed.start.chapter;
                }
                const eIdx = bibleData.findIndex(b => b.name === parsed.end.book);
                if (eIdx !== -1) {
                    document.getElementById('end-book').value = eIdx;
                    updateChapterDropdown('end');
                    document.getElementById('end-chapter').value = parsed.end.chapter;
                }
            }
            
            document.getElementById('btn-submit').innerText = "기록 수정하기";
            
            const modal = document.getElementById('date-detail-modal');
            const content = document.getElementById('date-detail-content');
            modal.classList.remove('hidden');
            requestAnimationFrame(() => {
                content.classList.remove('translate-y-full');
            });
        };

        // Delete Logic
        window.confirmDelete = function(id) {
            deletingRecordId = id;
            const modal = document.getElementById('delete-confirm-modal');
            const content = document.getElementById('delete-confirm-content');
            modal.classList.remove('hidden');
            requestAnimationFrame(() => {
                content.classList.remove('scale-95', 'opacity-0');
            });
        };

        window.closeDeleteModal = function() {
            deletingRecordId = null;
            const modal = document.getElementById('delete-confirm-modal');
            const content = document.getElementById('delete-confirm-content');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        };

        window.executeDelete = async function() {
            if (!deletingRecordId || !currentUser) return;
            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'reading_records', deletingRecordId);
                await deleteDoc(docRef);
                closeDeleteModal();
            } catch (error) {
                console.error("Error deleting document:", error);
                alertCustom("삭제에 실패했습니다.");
            }
        };

        // Data Writing & Updating
        window.submitRecord = async function() {
            if (!currentUser) return;
            
            const nameVal = document.getElementById('input-name').value.trim();
            if (!nameVal) {
                alertCustom("이름을 입력해주세요.");
                return;
            }

            localStorage.setItem('bibleTrackerNickname', nameVal);
            userNickname = nameVal;

            const sBookIdx = document.getElementById('start-book').value;
            const sChap = document.getElementById('start-chapter').value;
            const eBookIdx = document.getElementById('end-book').value;
            const eChap = document.getElementById('end-chapter').value;

            const startBookName = bibleData[sBookIdx].name;
            const endBookName = bibleData[eBookIdx].name;

            let rangeStr = `${startBookName} ${sChap}장`;
            if (startBookName !== endBookName || sChap !== eChap) {
                rangeStr += ` ~ ${endBookName} ${eChap}장`;
            }

            const medVal = document.getElementById('input-meditation').value.trim();
            const btnSubmit = document.getElementById('btn-submit');

            const originalText = btnSubmit.innerText;
            btnSubmit.innerText = "저장 중...";
            btnSubmit.disabled = true;
            btnSubmit.classList.add('opacity-50', 'cursor-not-allowed');

            try {
                if (editingRecordId) {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'reading_records', editingRecordId);
                    await updateDoc(docRef, {
                        nickname: nameVal,
                        range: rangeStr,
                        meditation: medVal
                    });
                    editingRecordId = null; // Reset edit state
                } else {
                    const recordsRef = collection(db, 'artifacts', appId, 'public', 'data', 'reading_records');
                    await addDoc(recordsRef, {
                        userId: currentUser.uid,
                        nickname: nameVal,
                        date: selectedDateStr,
                        range: rangeStr,
                        meditation: medVal,
                        timestamp: serverTimestamp()
                    });
                }

                document.getElementById('input-meditation').value = '';
                
                setTimeout(() => {
                    renderDailyRecords();
                    closeDateModal(); // 기록 완료 시 모달 닫아주기 (달력 밑에서 확인가능)
                }, 300);
                
            } catch (error) {
                console.error("Error adding document: ", error);
                alertCustom("저장에 실패했습니다. 다시 시도해주세요.");
            } finally {
                btnSubmit.innerText = originalText;
                btnSubmit.disabled = false;
                btnSubmit.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        };

        // Populate dynamic list of group members in dropdown
        function updateMemberFilterOptions() {
            const selectEl = document.getElementById('filter-member');
            if (!selectEl) return;

            const currentVal = selectEl.value || 'ALL';
            const uniqueNames = [...new Set(allRecords.map(r => r.nickname).filter(Boolean))].sort();

            let optionsHtml = '<option value="ALL">👤 모든 그룹원</option>';
            uniqueNames.forEach(name => {
                optionsHtml += `<option value="${escapeHtml(name)}">👤 ${escapeHtml(name)}</option>`;
            });

            selectEl.innerHTML = optionsHtml;
            selectEl.value = uniqueNames.includes(currentVal) ? currentVal : 'ALL';
            filterMember = selectEl.value;
        }

        window.onFilterChange = function() {
            const selectEl = document.getElementById('filter-member');
            const dateEl = document.getElementById('filter-date');
            
            if (selectEl) filterMember = selectEl.value;
            if (dateEl) filterDate = dateEl.value;

            renderAllRecordsView();
        };

        window.changeFilterDate = function(delta) {
            let targetDate;
            if (filterDate) {
                const [y, m, d] = filterDate.split('-').map(Number);
                targetDate = new Date(y, m - 1, d); // Date 객체 생성 시 월은 0부터 시작
            } else {
                targetDate = new Date();
            }
            
            targetDate.setDate(targetDate.getDate() + delta);
            filterDate = formatDate(targetDate);
            
            const dateEl = document.getElementById('filter-date');
            if (dateEl) dateEl.value = filterDate;
            
            renderAllRecordsView();
        };

        window.clearDateFilter = function() {
            const dateEl = document.getElementById('filter-date');
            if (dateEl) {
                dateEl.value = '';
                filterDate = '';
                renderAllRecordsView();
            }
        };

        function renderAllRecordsView() {
            updateMemberFilterOptions();
            elAllRecordsList.innerHTML = '';

            let filtered = allRecords;

            // Apply Group Member Filter
            if (filterMember !== 'ALL') {
                filtered = filtered.filter(r => r.nickname === filterMember);
            }

            // Apply Date Filter
            if (filterDate) {
                filtered = filtered.filter(r => r.date === filterDate);
            }
            
            if (filtered.length === 0) {
                elAllRecordsList.innerHTML = `
                    <div class="text-center py-10 text-app-text-muted text-sm border border-dashed border-app-border rounded-xl mt-4 bg-app-bg/30">
                        선택한 조건에 해당하는 기록이 없습니다.
                    </div>`;
                return;
            }

            let currentDateHeader = '';

            filtered.forEach(rec => {
                if (rec.date !== currentDateHeader) {
                    const header = document.createElement('h3');
                    const [y, m, d] = rec.date.split('-');
                    header.className = 'font-bold text-app-text-muted text-xs mt-5 mb-2 sticky top-0 bg-app-card py-1 border-b border-app-border/80 z-10 flex items-center gap-1';
                    header.innerHTML = `<span>📅 ${y}년 ${parseInt(m)}월 ${parseInt(d)}일</span>`;
                    elAllRecordsList.appendChild(header);
                    currentDateHeader = rec.date;
                }

                const isMe = currentUser && rec.userId === currentUser.uid;
                let actionsHtml = '';
                if (isMe) {
                    actionsHtml = `
                        <div class="flex items-center gap-2 ml-2 border-l border-app-border/50 pl-2">
                            <button onclick="openEditModal('${rec.id}')" class="text-[11px] text-app-text-muted hover:text-white transition">수정</button>
                            <button onclick="confirmDelete('${rec.id}')" class="text-[11px] text-app-text-muted hover:text-red-400 transition">삭제</button>
                        </div>
                    `;
                }

                const el = document.createElement('div');
                el.className = `p-4 rounded-xl border ${isMe ? 'border-app-gold/30 bg-app-gold/5' : 'border-app-border bg-app-bg'} mb-3 shadow-sm`;
                el.innerHTML = `
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-bold text-sm text-app-gold flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-app-gold inline-block"></span>
                            ${escapeHtml(rec.nickname)}
                        </span>
                        <div class="flex items-center">
                            <span class="text-xs text-app-text-muted">${formatTime(rec.timestamp)}</span>
                            ${actionsHtml}
                        </div>
                    </div>
                    <div class="text-sm text-white mb-2 pb-2 border-b border-app-border/40 break-words font-semibold">
                        📖 ${escapeHtml(rec.range)}
                    </div>
                    ${rec.meditation ? `
                        <div class="text-sm text-gray-200 break-words whitespace-pre-wrap leading-relaxed mt-2.5 p-3 bg-black/25 rounded-lg border border-white/5">
                            ${escapeHtml(rec.meditation)}
                        </div>
                    ` : ''}
                `;
                elAllRecordsList.appendChild(el);
            });
        }

        // --- Interaction Handlers ---

        window.changeMonth = function(delta) {
            currentMonth += delta;
            if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            } else if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            }
            // Auto-select 1st of the new month to show correct daily view
            selectedDateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-01`;
            updateUI();
        };

        window.switchTab = function(tab) {
            currentTab = tab;
            
            const btnCal = document.getElementById('tab-calendar');
            const btnAll = document.getElementById('tab-all');
            const viewCal = document.getElementById('view-calendar');
            const viewAll = document.getElementById('view-all');

            if (tab === 'calendar') {
                btnCal.className = 'flex-1 py-3 rounded-xl font-medium text-sm transition-colors bg-app-gold text-app-bg';
                btnAll.className = 'flex-1 py-3 rounded-xl font-medium text-sm transition-colors bg-app-card text-app-text-muted hover:bg-white/5';
                viewCal.classList.remove('hidden');
                viewAll.classList.add('hidden');
            } else {
                btnAll.className = 'flex-1 py-3 rounded-xl font-medium text-sm transition-colors bg-app-gold text-app-bg';
                btnCal.className = 'flex-1 py-3 rounded-xl font-medium text-sm transition-colors bg-app-card text-app-text-muted hover:bg-white/5';
                viewAll.classList.remove('hidden');
                viewCal.classList.add('hidden');
            }
            updateUI();
        };

        // --- Utilities ---

        // formatDate 함수는 위쪽으로 이동됨 (초기 상태 설정을 위해)

        function formatTime(ms) {
            const date = new Date(ms);
            let h = date.getHours();
            const m = String(date.getMinutes()).padStart(2, '0');
            const ampm = h >= 12 ? '오후' : '오전';
            h = h % 12;
            h = h ? h : 12; // the hour '0' should be '12'
            return `${ampm} ${h}:${m}`;
        }

        function escapeHtml(unsafe) {
            if (!unsafe) return '';
            return unsafe
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        }

        // Custom alert replacement
        function alertCustom(msg) {
            // Simple visual feedback since alert() is prohibited
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-20 left-1/2 transform -translate-x-1/2 bg-white text-black px-4 py-2 rounded-full shadow-lg text-sm z-50 transition-opacity duration-300';
            toast.innerText = msg;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Boot
        init();

    </script>
</body>
</html>
```